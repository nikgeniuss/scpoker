    "@types/node": "^24.12.3",
    "@vitest/coverage-v8": "^2.1.9",
    "nodemon": "^3.1.14",
    "pokersolver": "^2.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^3.3.12",
